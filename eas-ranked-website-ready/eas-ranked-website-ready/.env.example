# ============================================================
# EAS Ranked Website — Environment Variables
# Copy this file to .env.local and fill in the values.
# Never commit .env.local to version control.
# ============================================================

# ------------------------------------------------------------
# Database
# ------------------------------------------------------------
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ------------------------------------------------------------
# Discord OAuth
# ------------------------------------------------------------
NEXT_PUBLIC_DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/discord

# Discord bot token (for server-side Discord API calls)
DISCORD_BOT_TOKEN=your_discord_bot_token

# Discord guild (server) ID
DISCORD_GUILD_ID=your_discord_guild_id

# ------------------------------------------------------------
# Bot Integration
# ------------------------------------------------------------
# Secret token used by the game bot to authenticate kill-log
# requests to POST /api/admin/kills/log.
# Generate a strong random string, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BOT_KILLS_TOKEN=replace_with_a_strong_random_secret

# ------------------------------------------------------------
# App
# ------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
